# ---------------------------------------------------------------------------
# Noble Key Supply ads dashboard — configuration
# Copy to .env and fill in. .env is gitignored; never commit real tokens.
# ---------------------------------------------------------------------------

# Set to 1 once both connectors below are configured. Leave unset/0 to run the
# dashboard entirely from fixture data (mock mode), which is loudly labelled in
# the UI so mock numbers can never be mistaken for real ones.
LIVE_DATA=0

# --- Meta Marketing API ----------------------------------------------------
# System User token with `ads_read` on the ad account. See README § Meta.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXXXXX
META_API_VERSION=v21.0
# The action_type that counts as an acquired account. Inspect the `actions`
# array in a raw snapshot and pick deliberately — this drives CAC.
META_CONVERSION_ACTION=offsite_conversion.fb_pixel_purchase
# Stored alongside every value so the numbers can be defended later.
META_ATTRIBUTION_WINDOWS=7d_click,1d_view

# --- Google Ads API (YouTube video campaigns) ------------------------------
# YouTube ads live in Google Ads, not the YouTube Data API. See README § Google.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# The account holding the campaigns, digits only, no dashes.
GOOGLE_ADS_CUSTOMER_ID=
# The MCC/manager account above it, digits only. Omit if there is no manager.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Conversion action names that count as an acquired account, comma separated.
# Leave blank to use all conversions (and the UI will say so).
GOOGLE_ADS_CONVERSION_ACTIONS=

# --- Business constants ----------------------------------------------------
# Defaults match the client's stated numbers; override here, never in code.
CAC_BENCHMARK=550
CAC_TARGET=500
GROSS_MARGIN=0.40
BASELINE_MONTHLY_REV=240000
ACCOUNT_LTV_GP=4800
ACCOUNT_MONTHLY_GP=240

# First calendar month of the media program, YYYY-MM. Drives the spend pacing
# plan ($10K months 1-3, $15K months 4-6, $20K month 7+). If unset the current
# month is assumed to be month 1 and the UI flags the assumption.
PROGRAM_START_MONTH=

# --- Runtime ---------------------------------------------------------------
DB_PATH=data/dashboard.db
SYNC_INTERVAL_HOURS=6
